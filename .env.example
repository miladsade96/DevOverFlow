# Copy to .env.local and add development credentials locally. Never commit secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MongoDB Atlas or another replica set; transactions are required.
MONGODB_URL=
# Keeps the original database name unless you change it deliberately.
MONGODB_DB_NAME=First
# Clerk webhook signing secret for /api/webhook.
CLERK_WEBHOOK_SECRET=
# Optional: without Tiny Cloud, the forms use a basic textarea.
NEXT_PUBLIC_TINY_EDITOR_API_KEY=
# Optional: both values are required to enable AI answers.
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=
